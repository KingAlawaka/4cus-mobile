rules_version = '2';

// 4cus Firestore security rules.
//
// Collections:
//   users/{uid}
//   goal_posts/{postId}                 public discover feed
//   groups/{groupId}
//   groups/{groupId}/messages/{id}
//   groups/{groupId}/checkins/{uid_yyyy-MM-dd}
//   tasks/{taskId}
//   usage_days/{uid_yyyy-MM-dd}

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ---------- users ----------
    match /users/{uid} {
      // Any signed-in user can read profiles (needed for member names).
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid);
      allow delete: if false;
    }

    // ---------- goal posts (public discover feed) ----------
    match /goal_posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && (
        // Owner may edit anything.
        request.auth.uid == resource.data.ownerId
        // Anyone else may only bump memberCount by exactly 1
        // (join/leave flows run as the joining user).
        || (
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['memberCount'])
          && request.resource.data.memberCount
              == resource.data.memberCount + 1
        )
      );
      allow delete: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    // ---------- groups ----------
    match /groups/{groupId} {
      // Single-document reads are open to signed-in users so that
      // invite-code joins can fetch the group before joining.
      // Private groups are protected by unguessable IDs + invite codes;
      // LIST queries are still restricted below.
      allow get: if isSignedIn();
      allow list: if isSignedIn()
        && (!resource.data.isPrivate
            || request.auth.uid in resource.data.memberIds);

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.memberIds.size() <= 4;

      allow update: if isSignedIn()
        && request.resource.data.memberIds.size() <= 4
        && (
          // Members may edit non-membership fields.
          (
            request.resource.data.memberIds.toSet()
              == resource.data.memberIds.toSet()
            && request.auth.uid in resource.data.memberIds
          )
          // Self join: adds only self.
          || (
            request.auth.uid in request.resource.data.memberIds
            && !(request.auth.uid in resource.data.memberIds)
            && request.resource.data.memberIds.toSet()
                 .difference(resource.data.memberIds.toSet())
                 == [request.auth.uid].toSet()
            && resource.data.memberIds.toSet()
                 .difference(request.resource.data.memberIds.toSet())
                 .size() == 0
          )
          // Self leave: removes only self.
          || (
            request.auth.uid in resource.data.memberIds
            && !(request.auth.uid in request.resource.data.memberIds)
            && resource.data.memberIds.toSet()
                 .difference(request.resource.data.memberIds.toSet())
                 == [request.auth.uid].toSet()
            && request.resource.data.memberIds.toSet()
                 .difference(resource.data.memberIds.toSet())
                 .size() == 0
          )
        );

      allow delete: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    // ---------- chat messages ----------
    match /groups/{groupId}/messages/{messageId} {
      function parentMemberIds() {
        return get(
          /databases/$(database)/documents/groups/$(groupId)
        ).data.memberIds;
      }
      function isMember() {
        return isSignedIn()
          && request.auth.uid in parentMemberIds();
      }
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if false; // messages are immutable
    }

    // ---------- daily check-ins ----------
    match /groups/{groupId}/checkins/{checkinId} {
      function parentMemberIds() {
        return get(
          /databases/$(database)/documents/groups/$(groupId)
        ).data.memberIds;
      }
      function isMember() {
        return isSignedIn()
          && request.auth.uid in parentMemberIds();
      }
      allow read: if isMember();
      // Users can only post as themselves.
      allow create: if isMember()
        && request.resource.data.userId == request.auth.uid;
      // Verify toggles (peers) and own note/photo edits.
      allow update: if isMember();
      allow delete: if isMember()
        && resource.data.userId == request.auth.uid;
    }

    // ---------- personal tasks ----------
    match /tasks/{taskId} {
      allow read, delete: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
    }

    // ---------- usage days ----------
    // Document ID is {uid}_{yyyy-MM-dd}; the uid field must match the
    // authenticated user on both create and subsequent access.
    match /usage_days/{docId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
